#!/bin/sh
# Sigma OS 0.1 - live-build Konfiguration (Debian 13 "trixie", amd64)
set -e

lb config noauto \
    --distribution trixie \
    --architectures amd64 \
    --binary-images iso-hybrid \
    --archive-areas "main contrib non-free-firmware" \
    --debootstrap-options "--variant=minbase" \
    --apt-recommends false \
    --apt-indices false \
    --firmware-chroot false \
    --firmware-binary false \
    --debian-installer none \
    --memtest none \
    --chroot-squashfs-compression-type zstd \
    --bootappend-live "boot=live components quiet loglevel=3 preempt=full nowatchdog locales=de_DE.UTF-8 keyboard-layouts=de timezone=Europe/Berlin username=sigma hostname=sigma" \
    --image-name sigma-os-0.1 \
    --iso-application "Sigma OS" \
    --iso-publisher "Sigma OS Project" \
    --iso-volume "SIGMA_OS_0_1" \
    "${@}"
