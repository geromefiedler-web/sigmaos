<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
  </core>
  <theme>
    <cornerRadius>6</cornerRadius>
    <font name="Inter" size="10" />
  </theme>
  <keyboard>
    <default />
    <keybind key="W-Return"><action name="Execute" command="qterminal" /></keybind>
    <keybind key="W-e"><action name="Execute" command="pcmanfm-qt" /></keybind>
    <keybind key="W-b"><action name="Execute" command="firefox-esr" /></keybind>
    <keybind key="W-space"><action name="Execute" command="fuzzel" /></keybind>
    <keybind key="A-F2"><action name="Execute" command="fuzzel" /></keybind>
    <keybind key="W-l"><action name="Execute" command="swaylock -f -c 0b0f14" /></keybind>
    <keybind key="Print"><action name="Execute" command="sigma-screenshot" /></keybind>
    <keybind key="XF86_AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86_AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86_AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86_MonBrightnessUp"><action name="Execute" command="brightnessctl set +10%" /></keybind>
    <keybind key="XF86_MonBrightnessDown"><action name="Execute" command="brightnessctl set 10%-" /></keybind>
  </keyboard>
</labwc_config>
